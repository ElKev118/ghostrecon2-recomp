// Ghost Recon 2 port - the exe's icon and version information.
// The first icon is also the window's: SDL takes it from the exe.
#include <winver.h>
#include "../src/port/port_version.h"

1 ICON "ghostrecon2.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION    PORT_VERSION_NUM
 PRODUCTVERSION PORT_VERSION_NUM
 FILEFLAGSMASK  VS_FFI_FILEFLAGSMASK
 FILEFLAGS      0
 FILEOS         VOS_NT_WINDOWS32
 FILETYPE       VFT_APP
 FILESUBTYPE    VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription",  "Ghost Recon 2 - native PC port"
            VALUE "FileVersion",      PORT_VERSION
            VALUE "ProductName",      "Ghost Recon 2 PC port"
            VALUE "ProductVersion",   PORT_VERSION
            VALUE "OriginalFilename", "ghostrecon2.exe"
            VALUE "LegalCopyright",   "Ghost Recon 2 (c) Ubisoft / Red Storm. Port: see THIRD_PARTY_NOTICES.md"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
